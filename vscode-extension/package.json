{
  "name": "airctl-vscode",
  "displayName": "AirCtl",
  "version": "0.2.0",
  "description": "Air traffic control for localhost — discover, inspect, and control local development services from VS Code.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "developer-tools",
    "localhost",
    "ports",
    "processes"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x0arash/airctl.git",
    "directory": "vscode-extension"
  },
  "publisher": "0x0arash",
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "vsce package",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "airctl",
          "title": "AirCtl",
          "icon": "$(radio-tower)"
        }
      ]
    },
    "views": {
      "airctl": [
        {
          "id": "airctl.services",
          "name": "Services"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "airctl.services",
        "contents": "No services found.\n\nMake sure airctl is installed and on your PATH.\n[Install airctl](https://github.com/0x0arash/airctl)\n\n[Refresh](command:airctl.refresh)\n[Find a service](command:airctl.findService)\n[Open terminal dashboard](command:airctl.openTui)"
      }
    ],
    "commands": [
      {
        "command": "airctl.refresh",
        "title": "AirCtl: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "airctl.explainPort",
        "title": "AirCtl: Explain Port"
      },
      {
        "command": "airctl.stopService",
        "title": "AirCtl: Stop Service",
        "icon": "$(debug-stop)"
      },
      {
        "command": "airctl.findService",
        "title": "AirCtl: Find Service",
        "icon": "$(search)"
      },
      {
        "command": "airctl.inspectService",
        "title": "AirCtl: Service Actions"
      },
      {
        "command": "airctl.openTui",
        "title": "AirCtl: Open Terminal Dashboard"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "airctl.refresh",
          "when": "view == airctl.services",
          "group": "navigation"
        },
        {
          "command": "airctl.findService",
          "when": "view == airctl.services",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "airctl.stopService",
          "when": "view == airctl.services && viewItem == service",
          "group": "inline"
        },
        {
          "command": "airctl.explainPort",
          "when": "view == airctl.services && viewItem == port"
        }
      ],
      "editor/context": [
        {
          "command": "airctl.explainPort",
          "group": "airctl"
        }
      ]
    },
    "configuration": {
      "title": "AirCtl",
      "properties": {
        "airctl.path": {
          "type": "string",
          "default": "",
          "description": "Path to the airctl binary. Leave empty to auto-detect.",
          "scope": "machine"
        },
        "airctl.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "Auto-refresh interval in seconds."
        },
        "airctl.detailedDiscovery": {
          "type": "boolean",
          "default": false,
          "description": "Include Docker containers, connection topology, and health probes. Refreshes may take longer."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "AirCtl executes a local CLI to inspect and control processes."
    }
  }
}
